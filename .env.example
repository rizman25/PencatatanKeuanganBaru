# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — it must never be committed.
#
# Both values come from the Supabase dashboard:
#   Settings → API
#
# These two are safe in a browser. The anon key is designed to be public;
# row-level security is what actually protects the data.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# NOT USED — do not add the service_role key or the database password here.
#
#   service_role key  — bypasses row-level security entirely. The app never needs it.
#   database password — dashboard and psql only. Keep it in your password manager.
